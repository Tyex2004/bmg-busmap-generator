<Window x:Class="BusMapGenerator.SetStationNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置站名" Height="300" Width="360" WindowStartupLocation="CenterOwner"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        KeyDown="TextBox_PreviewKeyDown">
    <!-- 新增：用于监听 Enter 键 -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="中文站名：" VerticalAlignment="Center" Width="70"/>
            <TextBox x:Name="NameTextBox" Width="240" Height="28"/>
            <!-- 新增 -->
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,5,10,5">
            <TextBlock Text="英文站名：" VerticalAlignment="Center" Width="70"/>
            <TextBox x:Name="EnNameTextBox" Width="240" Height="28"/>
            <!-- 新增 -->
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,5,10,5">
            <TextBlock Text="连接地铁站：" VerticalAlignment="Center" Width="80"/>
            <TextBox x:Name="SetMtrSta" Width="90" Height="28"/>
            <TextBlock Text="备注：" VerticalAlignment="Center" Width="40" Margin="21 0 0 0"/>
            <TextBox x:Name="SetNote" Width="79" Height="28"/>
            <!-- 新增 -->
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="OkButton" Content="完成" Width="75" Margin="0,0,10,0" Click="OkButton_Click"/>
            <Button Content="取消" Width="75" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
